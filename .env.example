# Copy to .env and adjust for your environment. docker-compose reads this automatically.

DB_NAME=itms
DB_USERNAME=itms
DB_PASSWORD=itms

# Host-side ports. Defaults avoid clashing with other local projects that use
# the conventional 5432/8080/5173 ports.
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=5174

CORS_ALLOWED_ORIGINS=http://localhost:5174
VITE_API_URL=http://localhost:8081/api

# Generate a real secret before any non-local deployment, e.g.: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-before-any-real-deployment-32bytes+
