# Copy this file to `.env` on the server (same directory as docker-compose.prod.yml)
# and fill in real values. Never commit the real `.env` - it's already gitignored.

# --- Database ---
DB_NAME=itms
DB_USERNAME=itms
# Generate with: openssl rand -base64 24
DB_PASSWORD=

# --- Backend auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Networking (replace YOUR_VM_IP with the server's real IP address) ---
# Must match the origin the browser actually loads the frontend from, or the
# backend will reject its requests with a CORS error.
CORS_ALLOWED_ORIGINS=http://YOUR_VM_IP:5174
# Baked into the frontend's static build at image-build time - if this is wrong,
# rebuilding the frontend image is the only way to fix it (see the deploy guide).
VITE_API_URL=http://YOUR_VM_IP:8081/api

# --- Host ports (defaults shown - only set these if something else on the VM
#     is already using 8081/5174/5433) ---
# BACKEND_HOST_PORT=8081
# FRONTEND_HOST_PORT=5174
# DB_HOST_PORT=5433
